<?xml version="1.0"?>
<component name="io.maretha.cp.core.bulk.actions.upload" version="1.0.0">
    <!-- bulk action -->
    <require>org.nuxeo.ecm.core.bulk</require>

    <extension target="org.nuxeo.ecm.core.bulk" point="actions">
        <action name="bulkInteractionAction" inputStream="document/bulkInteractionAction" bucketSize="${cp.upload.action.bucketSize:=1}" batchSize="${cp.upload.action.batchSize:=1}"
        defaultScroller="elastic" httpEnabled="false" />
        <action name="bulkRegenerateEmbeddingsAction" inputStream="document/bulkRegenerateEmbeddingsAction" bucketSize="${cp.embeddings.action.bucketSize:=10}" batchSize="${cp.embeddings.action.batchSize:=10}"
        defaultScroller="elastic" httpEnabled="false" />
    </extension>

    <extension target="org.nuxeo.runtime.stream.service" point="streamProcessor">
        <streamProcessor name="bulkInteractionAction" class="io.maretha.cp.core.bulk.actions.BulkInteractionAction"
        defaultConcurrency="${cp.upload.action.defaultConcurrency:=4}" defaultPartitions="${cp.upload.action.partitions:=12}">
              <policy name="default" maxRetries="5" delay="30s" maxDelay="5m" continueOnFailure="true"/>
        </streamProcessor>
        <streamProcessor name="bulkRegenerateEmbeddingsAction" class="io.maretha.cp.core.bulk.actions.BulkRegenerateEmbeddingsAction"
        defaultConcurrency="${cp.embeddings.action.defaultConcurrency:=4}" defaultPartitions="${cp.embeddings.action.partitions:=12}">
              <policy name="default" maxRetries="5" delay="30s" maxDelay="5m" continueOnFailure="true"/>
        </streamProcessor>
    </extension>
</component>
