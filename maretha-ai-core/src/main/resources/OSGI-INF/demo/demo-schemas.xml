<?xml version="1.0"?>
<component name="io.maretha.ai.demo.types">

    <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
        <schema name="ai" prefix="ai" src="demo/schemas/demo-doc.xsd"/>
    </extension>

    <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
        <doctype name="AI" extends="Document" lifecycle="default">
            <schema name="dublincore"/>
            <schema name="common"/>
            <schema name="uid"/>
            <schema name="file"/>
            <schema name="files"/>
            <schema name="ai"/>
            <facet name="NXTag"/>
        </doctype>

        <doctype name="Folder" append="true">
            <subtypes>
                <type>AI</type>
            </subtypes>
        </doctype>
    </extension>


</component>
