<?xml version="1.0"?>
<component name="io.maretha.cp.core.listener.cpListener">
    <extension target="org.nuxeo.ecm.core.event.EventServiceComponent" point="listener">
        <listener name="bulkEventListener" async="true" postCommit="true"
                  class="io.maretha.cp.core.events.BulkEventListener" priority="100">
            <event>bulkInteractionsEvent</event>
        </listener>

        <listener name="interactionEventListener" async="false" postCommit="false"
                  class="io.maretha.cp.core.events.InteractionsEventListener" priority="99">
            <event>documentCreated</event>
            <!--<event>documentModified</event>-->
            <event>beforeDocumentModification</event>
        </listener>
    </extension>

</component>