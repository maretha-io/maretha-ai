<?xml version="1.0"?>
<component name="io.maretha.cp.core.types">

    <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
        <schema name="interactionSettings" prefix="interactionsettings" src="data/schemas/interaction-settings.xsd"/>
        <schema name="interactionResults" prefix="interactionresults" src="data/schemas/interaction-results.xsd"/>
    </extension>

    <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
        <doctype name="InteractionSettings" extends="Document" lifecycle="default">
            <schema name="dublincore"/>
            <schema name="common"/>
            <schema name="uid"/>
            <schema name="file"/>
            <schema name="interactionSettings"/>
            <facet name="Versionable"/>
            <facet name="HiddenInNavigation"/>
        </doctype>

        <doctype name="InteractionResults" extends="Document" lifecycle="default">
            <schema name="dublincore"/>
            <schema name="common"/>
            <schema name="uid"/>
            <schema name="file"/>
            <schema name="interactionResults"/>
        </doctype>

        <facet name="InteractionResultsFacet">
            <schema name="interactionResults" />
        </facet>
    </extension>

</component>
