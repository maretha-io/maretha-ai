<?xml version="1.0"?>
<component name="io.maretha.cp.core.page.providers">

    <extension target="org.nuxeo.ecm.platform.query.api.PageProviderService" point="providers">
        <genericPageProvider name="searchByEmbeddings" class="io.maretha.cp.core.search.CustomKnnSearch">
            <trackUsage>true</trackUsage>
            <searchDocumentType>XCM_insights_search_pp</searchDocumentType>
            <property name="pageSize">10</property>
            <sort column="dc:modified" ascending="false" />
            <pageSize>10</pageSize>
            <property name="coreSession">#{documentManager}</property>
            <property name="useUnrestrictedSession">false</property>
            <whereClause>
                <fixedPart>ecm:mixinType != 'HiddenInNavigation' AND ecm:isVersion = 0 AND ecm:isTrashed = 0 AND ecm:primaryType = 'XCM_Insights'</fixedPart>
                <predicate parameter="ecm:fulltext" operator="FULLTEXT">
                    <field schema="default_search" name="ecm_fulltext"/>
                </predicate>
                <predicate parameter="XCM_Insights:Title" operator="FULLTEXT">
                    <field schema="default_search" name="XCM_Insights_Title"/>
                </predicate>
                <predicate parameter="XCM_Insights:Creator_or_Author" operator="FULLTEXT">
                    <field schema="default_search" name="XCM_Insights_Creator_or_Author"/>
                </predicate>
                <predicate parameter="XCM_Insights:Keywords" operator="FULLTEXT">
                    <field schema="default_search" name="XCM_Insights_Keywords"/>
                </predicate>

            </whereClause>
            <aggregates>
                <aggregate id="XCM_Insights_Date_agg" type="date_range" parameter="XCM_Insights:Date">
                    <field schema="default_search" name="XCM_Insights_Date_agg"/>
                    <properties>
                        <property name="format">"dd-MM-yyyy"</property>
                    </properties>
                    <dateRanges>
                        <dateRange key="last24h" fromDate="now-24H" toDate="now"/>
                        <dateRange key="lastWeek" fromDate="now-7d" toDate="now-24H"/>
                        <dateRange key="lastMonth" fromDate="now-1M" toDate="now-7d"/>
                        <dateRange key="lastYear" fromDate="now-1y" toDate="now-1M"/>
                        <dateRange key="priorToLastYear" toDate="now-1y"/>
                    </dateRanges>
                </aggregate>
                <aggregate id="XCM_Insights_Language_agg" type="terms" parameter="XCM_Insights:Language">
                    <field schema="default_search" name="XCM_Insights_Language_agg"/>
                    <properties>
                        <property name="size">20</property>
                        <property name="orderBucketsBy">term desc</property>
                    </properties>
                </aggregate>
                <aggregate id="XCM_Insights_Country_agg" type="terms" parameter="XCM_Insights:Country">
                    <field schema="default_search" name="XCM_Insights_Country_agg"/>
                    <properties>
                        <property name="size">20</property>
                        <property name="orderBucketsBy">count desc</property>
                    </properties>
                </aggregate>
                <aggregate id="XCM_Insights_Big_Rock_agg" type="terms" parameter="XCM_Insights:Big_Rock">
                    <field schema="default_search" name="XCM_Insights_Big_Rock_agg"/>
                    <properties>
                        <property name="size">20</property>
                        <property name="orderBucketsBy">count desc</property>
                    </properties>
                </aggregate>
                <aggregate id="XCM_Insights_Quarter_agg" type="terms" parameter="XCM_Insights:Quarter">
                    <field schema="default_search" name="XCM_Insights_Quarter_agg"/>
                    <properties>
                        <property name="size">20</property>
                        <property name="orderBucketsBy">count desc</property>
                    </properties>
                </aggregate>
                <aggregate id="XCM_Insights_Year_agg" type="terms" parameter="XCM_Insights:Year">
                    <field schema="default_search" name="XCM_Insights_Year_agg"/>
                    <properties>
                        <property name="size">20</property>
                        <property name="orderBucketsBy">count desc</property>
                    </properties>
                </aggregate>
            </aggregates>
        </genericPageProvider>
    </extension>
</component>