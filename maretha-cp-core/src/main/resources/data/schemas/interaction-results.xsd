<?xml version="1.0"?>
<xs:schema targetNamespace="http://www.nuxeo.core/ecm/schemas/interactionResults/"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:nxs="http://www.nuxeo.core/ecm/schemas/interactionResults/">

    <!-- Root element definition for interactions -->
    <xs:element name="interactions" type="nxs:interactionResultList"/>
    <xs:element name="storeId" type="xs:string"/>
    <xs:element name="storedDate" type="xs:dateTime"/>

    <!-- Definition for a list of interactions -->
    <xs:complexType name="interactionResultList">
        <xs:sequence>
            <xs:element name="interactionResult" type="nxs:interactionResultType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Definition for the interactions complex type -->
    <xs:complexType name="interactionResultType">
        <xs:sequence>
            <xs:element name="id" type="xs:string"/>
            <xs:element name="interactionId" type="xs:string"/>
            <xs:element name="documentId" type="xs:string"/>
            <xs:element name="response" type="xs:string"/>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="status" type="xs:string"/>
            <xs:element name="createdAt" type="xs:dateTime"/>
            <xs:element name="createdBy" type="xs:string"/>
            <xs:element name="parameters" type="nxs:interactionParameterList"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="interactionParameterList">
        <xs:sequence>
            <xs:element name="parameterResult" type="nxs:interactionResultParameter" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="stringList">
        <xs:sequence>
            <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="interactionResultParameter">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="type" type="xs:string"/>
            <xs:element name="format" type="xs:string"/>
            <xs:element name="value" type="xs:string"/>
            <xs:element name="readOnly" type="xs:boolean"/>
            <xs:element name="enableDocSelection" type="xs:boolean"/>
            <xs:element name="isMainDocument" type="xs:boolean"/>
            <xs:element name="selectionReadOnly" type="xs:boolean"/>
            <xs:element name="selectedDocumentIds" type="nxs:stringList"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>