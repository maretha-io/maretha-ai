<?xml version="1.0"?>
<xs:schema targetNamespace="http://www.nuxeo.core/ecm/schemas/testDoc/"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:nxs="http://www.nuxeo.core/ecm/schemas/testDoc/">

    <xs:element name="testString" type="xs:string"/>
    <xs:element name="testDate" type="xs:dateTime"/>
    <xs:element name="testDoubleArray" type="nxs:doubleList"/>
    <xs:element name="testStringArray" type="nxs:stringList"/>

    <xs:complexType name="stringList">
        <xs:sequence>
            <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="doubleList">
        <xs:sequence>
            <xs:element name="item" type="xs:double" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>