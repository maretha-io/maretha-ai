## maretha-ai template - addon configuration only.
## Infra endpoints (MongoDB, S3, OpenSearch) are owned by the deployment's nuxeo.conf;
## this template deliberately sets no defaults for them.
## Including opensearch2-search-client forces this template to process after it, so the
## knn-enabled opensearch2-doc-mapping.json / opensearch2-doc-settings.json.nxftl below
## override the stock ones (template includes are ordered before the includer, dedup'd).
maretha-ai.target=.
nuxeo.template.includes=common,opensearch2-search-client

nuxeo.dbs.cache.enabled=false
nuxeo.dbs.cache.maxSize=1000

##Increase threads
nuxeo.server.http.maxThreads=300
nuxeo.server.http.acceptCount=400

##cors
nuxeo.cors.supportedMethods=*
nuxeo.cors.pattern=/nuxeo/.*
nuxeo.cors.urls=https://demo.maretha.io/nuxeo

cp.upload.action.bucketSize=1
cp.upload.action.batchSize=1
cp.upload.action.defaultConcurrency=4
cp.upload.action.partitions=12

io.maretha.aws.accessKeyId=${env:AWS_BEDROCK_ACCESS_KEY}
io.maretha.aws.secretAccessKey=${env:AWS_BEDROCK_SECRET_KEY}
io.maretha.aws.region=${env:AWS_BEDROCK_REGION:us-east-1}
io.maretha.aws.inferenceProfile=${env:AWS_BEDROCK_INFERENCE_PROFILE}

generative.ai.openai.apikey=${env:OPENAI_KEY}
generative.ai.openai.organization=${env:OPENAI_ORG}
