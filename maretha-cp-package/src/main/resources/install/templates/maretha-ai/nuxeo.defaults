maretha-ai.target=.
nuxeo.template.includes=common,mongodb,maretha-ai

nuxeo.dbs.cache.enabled=false
nuxeo.dbs.cache.maxSize=1000

nuxeo.s3storage.bucket=${env:S3_BUCKET}
nuxeo.s3storage.bucket_prefix=binaries/
nuxeo.s3storage.region=us-east-1
nuxeo.s3storage.transient.bucket_prefix=transient/

nuxeo.s3storage.awsid=${env:S3_IAM_USER}
nuxeo.s3storage.awssecret=${env:S3_IAM_SECRET}
nuxeo.s3storage.directdownload=true
nuxeo.s3storage.directdownload.expire=36000
nuxeo.s3storage.useDirectUpload=false
nuxeo.s3storage.transient.bucket=${env:S3_TRANSIENT_BUCKET}


nuxeo.mongodb.server=${env:MONGO_SERVER:mongodb://localhost:27017}
nuxeo.mongodb.dbname=${env:MONGO_DBNAME:nuxeo}


elasticsearch.restClient.username=${env:ELASTIC_NAME}
elasticsearch.restClient.password=${env:ELASTIC_PASSWORD}
elasticsearch.addressList=${env:ELASTIC_SERVER}


generative.ai.openai.apikey=${env:OPENAI_KEY}
generative.ai.openai.organization=${env:OPENAI_ORG}

##Increase threads
nuxeo.server.http.maxThreads=300
nuxeo.server.http.acceptCount=400
nuxeo.vcs.min-pool-size=50
nuxeo.vcs.max-pool-size=400
nuxeo.vcs.blocking-timeout-millis=500
nuxeo.vcs.idle-timeout-minutes=1


##cors
nuxeo.cors.supportedMethods=*
nuxeo.cors.pattern=/nuxeo/.*
nuxeo.cors.urls=https://demo.maretha.io/nuxeo


cp.upload.action.bucketSize=1
cp.upload.action.batchSize=1
cp.upload.action.defaultConcurrency=4
cp.upload.action.partitions=12

io.maretha.aws.accessKeyId=${env:AWS_BEDROCK_ACCESS_KEY}
io.maretha.aws.secretAccessKey=${env:AWS_BEDROCK_SECRET_KEY}
io.maretha.aws.region=${env:AWS_BEDROCK_REGION:us-east-1}
io.maretha.aws.inferenceProfile=${env:AWS_BEDROCK_INFERENCE_PROFILE}